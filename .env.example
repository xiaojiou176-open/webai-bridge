# WebaiBridge local credentialed browser defaults
# Copy the values you really need into your local .env or shell profile.
# Do not commit real credentials or machine-specific secrets.

WEBAI_BRIDGE_BROWSER_MODE=isolated-chrome-root
WEBAI_BRIDGE_CHROME_USER_DATA_DIR=~/.cache/webai-bridge/browser/chrome-user-data
WEBAI_BRIDGE_CHROME_PROFILE_NAME=webai-bridge

# Repo-external dedicated disposable cache root
WEBAI_BRIDGE_EXTERNAL_CACHE_ROOT=~/.cache/webai-bridge
WEBAI_BRIDGE_CACHE_TTL_DAYS=7
WEBAI_BRIDGE_CACHE_MAX_BYTES=5368709120

# Optional advanced / fallback overrides
# Keep the managed fallback profile inside repo-local .runtime-cache/.
# WEBAI_BRIDGE_WEB_AUTH_USER_DATA_DIR=.runtime-cache/webai-bridge-web-auth-browser
# WEBAI_BRIDGE_WEB_AUTH_CDP_URL=http://127.0.0.1:39222
# WEBAI_BRIDGE_WEB_AUTH_EXISTING_PROFILE_CDP_URL=http://127.0.0.1:9338
# WEBAI_BRIDGE_WEB_AUTH_EXISTING_BROWSER_SESSION_URL=http://127.0.0.1:9338
